// ─────────────────────────────────────────────────────────────────────────────
// InfluenceHub — Prisma Schema v3
// Auth (FR01–FR05) + User Management (FR06–FR10) + Community (FR11–FR15)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  BUSINESS
  AGENT
  INFLUENCER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InfluencerTier {
  DIAMOND
  GOLD
  SILVER
}

enum AuditAction {
  REGISTER
  LOGIN
  LOGOUT
  LOGOUT_ALL
  REFRESH_TOKEN
  FORGOT_PASSWORD
  VERIFY_RESET_CODE
  RESET_PASSWORD
  VERIFY_EMAIL
  RESEND_VERIFICATION
  FAILED_LOGIN
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PROFILE_UPDATED
  PASSWORD_CHANGED
  SUSPICIOUS_ACTIVITY
  // FR06
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  TIER_ASSIGNED
  // FR08
  BUSINESS_APPROVED
  BUSINESS_REJECTED
  // FR11–FR15
  COMMUNITY_CREATED
  COMMUNITY_UPDATED
  COMMUNITY_DEACTIVATED
  COMMUNITY_DELETED
  COMMUNITY_LEADER_ASSIGNED
  COMMUNITY_MEMBER_ADDED
  COMMUNITY_MEMBER_REMOVED
  COMMUNITY_COMMISSION_UPDATED
  // FR16–FR23
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_DELETED
  CAMPAIGN_SUBMITTED
  CAMPAIGN_ADMIN_APPROVED
  CAMPAIGN_ADMIN_REJECTED
  CAMPAIGN_LEADER_ACCEPTED
  CAMPAIGN_LEADER_REJECTED
  CAMPAIGN_ACTIVATED
  CAMPAIGN_PAUSED
  CAMPAIGN_COMPLETED
  CAMPAIGN_ASSIGNED
  CONVERSION_ADDED
  CONVERSION_UPDATED
  CONVERSION_DELETED
  // FR24–FR31
  TRACKING_CLICK
  TRACKING_CONVERSION
  REFERRAL_USED
  COMMISSION_CALCULATED
  EARNINGS_UPDATED
  WITHDRAWAL_SUBMITTED
  WITHDRAWAL_CANCELLED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  BALANCE_ADJUSTED
  // FR32–FR37
  MESSAGE_SENT
  MESSAGE_DELETED
  VOICE_MESSAGE_CREATED
  COMMUNITY_VIDEO_UPLOADED
  MEETING_LINK_CREATED
  CAMPAIGN_CONTENT_SUBMITTED
  CAMPAIGN_CONTENT_REVIEWED
}

enum NotificationType {
  BUSINESS_APPROVED
  BUSINESS_REJECTED
  TIER_CHANGED
  ACCOUNT_STATUS_CHANGED
  // FR11–FR15
  COMMUNITY_CREATED
  COMMUNITY_LEADER_ASSIGNED
  COMMUNITY_MEMBER_ADDED
  COMMUNITY_MEMBER_REMOVED
  COMMUNITY_COMMISSION_UPDATED
  // FR16–FR23
  CAMPAIGN_SUBMITTED
  CAMPAIGN_APPROVED
  CAMPAIGN_REJECTED
  CAMPAIGN_ACCEPTED
  CAMPAIGN_LEADER_REJECTED
  CAMPAIGN_ACTIVATED
  CAMPAIGN_PAUSED
  CAMPAIGN_COMPLETED
  // FR24–FR31
  NEW_CONVERSION
  EARNINGS_UPDATED
  WITHDRAWAL_SUBMITTED
  WITHDRAWAL_CANCELLED
  WITHDRAWAL_STATUS_CHANGED
  // FR32–FR37
  NEW_MESSAGE
  NEW_VOICE_MESSAGE
  NEW_COMMUNITY_VIDEO
  NEW_MEETING_LINK
  NEW_CAMPAIGN_CONTENT
  CAMPAIGN_CONTENT_REVIEWED
  GENERAL
}

// ─────────────────────────────────────────────────────────────────────────────
// FR11–FR15 ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum CommunityStatus {
  ACTIVE
  INACTIVE
}

enum CommunityMemberStatus {
  ACTIVE
  REMOVED
}

// ─────────────────────────────────────────────────────────────────────────────
// FR16–FR23 ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum CampaignType {
  SALES
  AWARENESS
  GROWTH
}

enum CampaignStatus {
  DRAFT
  PENDING_ADMIN_APPROVAL
  PENDING_LEADER_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum TrackingMethod {
  UNIQUE_LINK
  REFERRAL_CODE
  MANUAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// FR24–FR31 ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum TrackingEventType {
  CLICK
  CONVERSION
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PROCESSED
}

enum EarningStatus {
  PENDING    // conversion recorded, not yet settled
  AVAILABLE  // settled and available for withdrawal
  WITHDRAWN  // paid out
  CANCELLED  // reversed (e.g. fraudulent conversion)
}

// ─────────────────────────────────────────────────────────────────────────────
// USER — Extended with profile relations
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  firstName            String    @map("first_name") @db.VarChar(100)
  lastName             String    @map("last_name") @db.VarChar(100)
  email                String    @unique @db.VarChar(255)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  role                 Role      @default(INFLUENCER)
  status               UserStatus @default(PENDING_VERIFICATION)
  emailVerified        Boolean   @default(false) @map("email_verified")
  phone1               String?   @map("phone_1") @db.VarChar(30)
  phone2               String?   @map("phone_2") @db.VarChar(30)
  lastLogin            DateTime? @map("last_login")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  profileImage         String?   @map("profile_image") @db.VarChar(500)
  isSuspended          Boolean   @default(false) @map("is_suspended")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  // Auth relations
  refreshTokens        RefreshToken[]
  passwordResets       PasswordReset[]
  emailVerifications   EmailVerification[]
  auditLogs            AuditLog[]

  // Profile relations (FR06–FR10)
  businessProfile      BusinessProfile?
  influencerProfile    InfluencerProfile?
  agentProfile         AgentProfile?
  notifications        Notification[]
  createdByAdmin       User?     @relation("AdminCreatedUsers", fields: [createdBy], references: [id])
  createdBy            String?   @map("created_by") @db.Uuid
  managedUsers         User[]    @relation("AdminCreatedUsers")

  // Community relations (FR11–FR15)
  ledCommunities       Community[]       @relation("CommunityLeader")
  communityMemberships CommunityMember[]

  // Campaign relations (FR16–FR23)
  campaigns            Campaign[]        @relation("CampaignOwner")
  campaignApprovals    CampaignApproval[]
  trackingLinks        TrackingLink[]
  referralCodes        ReferralCode[]
  manualConversions    ManualConversion[]

  // Tracking & Earnings relations (FR24–FR31)
  trackingEvents       TrackingEvent[]
  earnings             Earning[]
  influencerBalance    InfluencerBalance?
  withdrawalRequests   WithdrawalRequest[]

  // Communication & Collaboration relations (FR32–FR37)
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]
  messageReads             MessageRead[]
  uploadedCommunityVideos  CommunityVideo[]
  createdMeetingLinks      MeetingLink[]
  submittedCampaignContents CampaignContent[]
  campaignContentReviews   CampaignContentReview[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// BUSINESS PROFILE — FR07 Business Owner Registration
// ─────────────────────────────────────────────────────────────────────────────

model BusinessProfile {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  businessName         String             @map("business_name") @db.VarChar(255)
  businessType         String?            @map("business_type") @db.VarChar(100)
  registrationNumber   String?            @map("registration_number") @db.VarChar(100)
  taxId                String?            @map("tax_id") @db.VarChar(100)
  website              String?            @db.VarChar(500)
  phone                String?            @db.VarChar(30)
  address              String?            @db.VarChar(500)
  city                 String?            @db.VarChar(100)
  country              String?            @db.VarChar(100)
  description          String?            @db.Text
  // Social media & extended business fields
  facebook             String?            @db.VarChar(500)
  instagram            String?            @db.VarChar(500)
  telegram             String?            @db.VarChar(500)
  tiktok               String?            @db.VarChar(500)
  logoStoragePath      String?            @map("logo_storage_path") @db.VarChar(1000)
  subscriptionType     String             @default("free") @map("subscription_type") @db.VarChar(50)
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt           DateTime?          @map("verified_at")
  verifiedBy           String?            @map("verified_by") @db.Uuid  // Admin user ID
  rejectionReason      String?            @map("rejection_reason") @db.Text
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")

  // Relations
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            BusinessDocument[]

  @@index([userId])
  @@index([verificationStatus])
  @@index([businessName])
  @@map("business_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// BUSINESS DOCUMENT — FR07 Secure document storage
// ─────────────────────────────────────────────────────────────────────────────

model BusinessDocument {
  id                String   @id @default(uuid()) @db.Uuid
  businessProfileId String   @map("business_profile_id") @db.Uuid
  documentType      String   @map("document_type") @db.VarChar(100)  // e.g. "business_license", "tax_cert"
  fileName          String   @map("file_name") @db.VarChar(255)
  fileSize          Int      @map("file_size")                        // bytes
  mimeType          String   @map("mime_type") @db.VarChar(100)
  storagePath       String   @map("storage_path") @db.VarChar(1000)  // private storage path/key
  uploadedAt        DateTime @default(now()) @map("uploaded_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@index([businessProfileId])
  @@map("business_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// INFLUENCER PROFILE — FR09 Influencer Tiers
// ─────────────────────────────────────────────────────────────────────────────

model InfluencerProfile {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @unique @map("user_id") @db.Uuid
  currentTier       InfluencerTier @default(SILVER) @map("current_tier")
  isCommunityLeader Boolean        @default(false) @map("is_community_leader") // Only DIAMOND can be true
  bio               String?        @db.Text
  niche             String?        @db.VarChar(100)        // e.g. "fashion", "tech", "fitness"
  socialHandles     Json?          @map("social_handles")  // { instagram, tiktok, youtube, etc. }
  followerCount     Int?           @map("follower_count")
  engagementRate    Float?         @map("engagement_rate")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")

  // Relations
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierHistory       InfluencerTierHistory[]

  @@index([userId])
  @@index([currentTier])
  @@map("influencer_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// INFLUENCER TIER HISTORY — FR09 Audit trail for tier changes
// ─────────────────────────────────────────────────────────────────────────────

model InfluencerTierHistory {
  id                  String         @id @default(uuid()) @db.Uuid
  influencerProfileId String         @map("influencer_profile_id") @db.Uuid
  previousTier        InfluencerTier? @map("previous_tier")
  newTier             InfluencerTier @map("new_tier")
  changedBy           String         @map("changed_by") @db.Uuid  // Admin user ID
  reason              String?        @db.VarChar(500)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  // Relations
  influencerProfile   InfluencerProfile @relation(fields: [influencerProfileId], references: [id], onDelete: Cascade)

  @@index([influencerProfileId])
  @@index([createdAt])
  @@map("influencer_tier_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// AGENT PROFILE — FR10 Agent Role
// ─────────────────────────────────────────────────────────────────────────────

model AgentProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  agencyName  String?   @map("agency_name") @db.VarChar(255)
  phone       String?   @db.VarChar(30)
  bio         String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("agent_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATION — FR08 In-app notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH MODELS (unchanged from FR01–FR05)
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo  String?   @map("device_info") @db.VarChar(500)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  isRevoked   Boolean   @default(false) @map("is_revoked")
  family      String?   @db.VarChar(100)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  otpHash   String    @map("otp_hash") @db.VarChar(255)
  isUsed    Boolean   @default(false) @map("is_used")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  otpHash   String    @map("otp_hash") @db.VarChar(255)
  isUsed    Boolean   @default(false) @map("is_used")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)
  metadata    Json?
  success     Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY — FR11 Community Creation
// ─────────────────────────────────────────────────────────────────────────────

model Community {
  id                String          @id @default(uuid()) @db.Uuid
  title             String          @unique @db.VarChar(255)
  description       String?         @db.Text
  rules             String?         @db.Text
  status            CommunityStatus @default(ACTIVE)
  communityLeaderId String?         @map("community_leader_id") @db.Uuid
  createdBy         String          @map("created_by") @db.Uuid         // SUPER_ADMIN or ADMIN id
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  // Relations
  leader            User?           @relation("CommunityLeader", fields: [communityLeaderId], references: [id])
  members           CommunityMember[]
  commission        CommunityCommission?
  commissionHistory CommunityCommissionHistory[]
  campaigns         Campaign[]
  manualConversions ManualConversion[]
  trackingEvents    TrackingEvent[]
  earnings          Earning[]
  conversations     Conversation[]
  videos            CommunityVideo[]
  meetingLinks      MeetingLink[]

  @@index([status])
  @@index([communityLeaderId])
  @@index([deletedAt])
  @@map("communities")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY MEMBER — FR13 Community Member Management
// ─────────────────────────────────────────────────────────────────────────────

model CommunityMember {
  id          String              @id @default(uuid()) @db.Uuid
  communityId String              @map("community_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  status      CommunityMemberStatus @default(ACTIVE)
  joinedAt    DateTime            @default(now()) @map("joined_at")
  leftAt      DateTime?           @map("left_at")
  addedBy     String              @map("added_by") @db.Uuid             // SUPER_ADMIN, ADMIN, or Community Leader
  removedBy   String?             @map("removed_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  // Relations
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])           // prevent duplicate active memberships
  @@index([communityId])
  @@index([userId])
  @@index([status])
  @@map("community_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY COMMISSION — FR12 Commission Rules (current active config)
// ─────────────────────────────────────────────────────────────────────────────

model CommunityCommission {
  id                 String    @id @default(uuid()) @db.Uuid
  communityId        String    @unique @map("community_id") @db.Uuid
  platformFee        Float     @map("platform_fee")          // e.g. 20.0  (%)
  leaderPercentage   Float     @map("leader_percentage")     // of remaining after platform fee
  memberPercentage   Float     @map("member_percentage")     // leaderPercentage + memberPercentage = 100
  effectiveFrom      DateTime  @default(now()) @map("effective_from")
  updatedBy          String    @map("updated_by") @db.Uuid   // SUPER_ADMIN or ADMIN
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  // Relations
  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@map("community_commissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY COMMISSION HISTORY — FR12 Immutable history for auditing
// Historical records are never modified — new record on every change.
// ─────────────────────────────────────────────────────────────────────────────

model CommunityCommissionHistory {
  id                 String    @id @default(uuid()) @db.Uuid
  communityId        String    @map("community_id") @db.Uuid
  platformFee        Float     @map("platform_fee")
  leaderPercentage   Float     @map("leader_percentage")
  memberPercentage   Float     @map("member_percentage")
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")          // null = currently active
  changedBy          String    @map("changed_by") @db.Uuid
  changeReason       String?   @map("change_reason") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  // Relations
  community          Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([effectiveFrom])
  @@map("community_commission_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN — FR16 Campaign Creation
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id                   String         @id @default(uuid()) @db.Uuid
  ownerId              String         @map("owner_id") @db.Uuid            // BUSINESS user id
  title                String         @db.VarChar(255)
  description          String?        @db.Text
  type                 CampaignType
  budget               Float                                               // must be > 0
  targetPlatform       String         @map("target_platform") @db.VarChar(100)
  startDate            DateTime       @map("start_date")
  endDate              DateTime       @map("end_date")                     // must be > startDate
  status               CampaignStatus @default(DRAFT)
  // FR17 — SALES campaign fields
  payoutPerConversion  Float?         @map("payout_per_conversion")        // required for SALES
  trackingMethod       TrackingMethod? @map("tracking_method")             // required for SALES
  // FR19/FR20 — rejection tracking
  adminRejectionReason  String?       @map("admin_rejection_reason") @db.Text
  leaderRejectionReason String?       @map("leader_rejection_reason") @db.Text
  // FR18 — assigned community
  communityId          String?        @map("community_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  // Relations
  owner                User           @relation("CampaignOwner", fields: [ownerId], references: [id])
  community            Community?     @relation(fields: [communityId], references: [id])
  approvals            CampaignApproval[]
  trackingLinks        TrackingLink[]
  referralCodes        ReferralCode[]
  manualConversions    ManualConversion[]
  trackingEvents       TrackingEvent[]
  earnings             Earning[]
  commissionCalculations CommissionCalculation[]
  contents             CampaignContent[]

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([communityId])
  @@index([deletedAt])
  @@map("campaigns")
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN APPROVAL — FR19/FR20 Admin + Leader approval
// ─────────────────────────────────────────────────────────────────────────────

model CampaignApproval {
  id           String         @id @default(uuid()) @db.Uuid
  campaignId   String         @map("campaign_id") @db.Uuid
  reviewerId   String         @map("reviewer_id") @db.Uuid               // admin or community leader
  reviewerRole String         @map("reviewer_role") @db.VarChar(50)      // 'SUPER_ADMIN' | 'ADMIN' | 'INFLUENCER' (DIAMOND tier)
  status       ApprovalStatus
  reason       String?        @db.Text                                   // mandatory on rejection
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  // Relations
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reviewer     User           @relation(fields: [reviewerId], references: [id])

  @@index([campaignId])
  @@index([reviewerId])
  @@index([status])
  @@map("campaign_approvals")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRACKING LINK — FR21 Unique per campaign + per influencer
// ─────────────────────────────────────────────────────────────────────────────

model TrackingLink {
  id           String    @id @default(uuid()) @db.Uuid
  campaignId   String    @map("campaign_id") @db.Uuid
  influencerId String    @map("influencer_id") @db.Uuid                  // community member user id
  code         String    @unique @db.VarChar(64)                         // secure random, globally unique
  url          String    @db.VarChar(1000)                               // full tracking URL
  clickCount   Int       @default(0) @map("click_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer   User      @relation(fields: [influencerId], references: [id])

  @@unique([campaignId, influencerId])    // one link per influencer per campaign
  @@index([campaignId])
  @@index([influencerId])
  @@index([code])
  @@map("tracking_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERRAL CODE — FR21 Unique per campaign + per influencer
// ─────────────────────────────────────────────────────────────────────────────

model ReferralCode {
  id           String    @id @default(uuid()) @db.Uuid
  campaignId   String    @map("campaign_id") @db.Uuid
  influencerId String    @map("influencer_id") @db.Uuid
  code         String    @unique @db.VarChar(32)                         // secure random uppercase alphanumeric
  useCount     Int       @default(0) @map("use_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer   User      @relation(fields: [influencerId], references: [id])

  @@unique([campaignId, influencerId])    // one code per influencer per campaign
  @@index([campaignId])
  @@index([influencerId])
  @@index([code])
  @@map("referral_codes")
}

// ─────────────────────────────────────────────────────────────────────────────
// MANUAL CONVERSION — FR23 Manual tracking entry by Business Owner
// ─────────────────────────────────────────────────────────────────────────────

model ManualConversion {
  id             String    @id @default(uuid()) @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  communityId    String    @map("community_id") @db.Uuid
  influencerId   String    @map("influencer_id") @db.Uuid
  amount         Float                                                    // payout amount for this conversion
  note           String?   @db.VarChar(500)
  convertedAt    DateTime  @map("converted_at")
  createdBy      String    @map("created_by") @db.Uuid                   // BUSINESS user id
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  community      Community @relation(fields: [communityId], references: [id])
  influencer     User      @relation(fields: [influencerId], references: [id])

  @@index([campaignId])
  @@index([communityId])
  @@index([influencerId])
  @@index([createdBy])
  @@index([convertedAt])
  @@map("manual_conversions")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRACKING EVENT — FR24/FR25 Click & Conversion via link or referral code
// One row per click; conversionTimestamp populated when conversion confirmed.
// ─────────────────────────────────────────────────────────────────────────────

model TrackingEvent {
  id                  String            @id @default(uuid()) @db.Uuid
  campaignId          String            @map("campaign_id") @db.Uuid
  communityId         String            @map("community_id") @db.Uuid
  influencerId        String            @map("influencer_id") @db.Uuid
  trackingLinkId      String?           @map("tracking_link_id") @db.Uuid   // set for UNIQUE_LINK
  referralCodeId      String?           @map("referral_code_id") @db.Uuid   // set for REFERRAL_CODE
  eventType           TrackingEventType
  ipAddress           String?           @map("ip_address") @db.VarChar(45)
  userAgent           String?           @map("user_agent") @db.VarChar(500)
  deviceInfo          String?           @map("device_info") @db.VarChar(255)
  clickedAt           DateTime          @map("clicked_at")
  convertedAt         DateTime?         @map("converted_at")               // null until conversion
  isConverted         Boolean           @default(false) @map("is_converted")
  isDuplicate         Boolean           @default(false) @map("is_duplicate") // duplicate click/conversion flag
  metadata            Json?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")

  // Relations
  campaign            Campaign          @relation(fields: [campaignId], references: [id])
  community           Community         @relation(fields: [communityId], references: [id])
  influencer          User              @relation(fields: [influencerId], references: [id])
  earning             Earning?          // one-to-one: set when conversion triggers earning

  @@index([campaignId])
  @@index([communityId])
  @@index([influencerId])
  @@index([eventType])
  @@index([isConverted])
  @@index([clickedAt])
  @@map("tracking_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// EARNING — FR26/FR27 Per-conversion earning record for an influencer
// Immutable once AVAILABLE. One record per conversion per influencer.
// ─────────────────────────────────────────────────────────────────────────────

model Earning {
  id                    String        @id @default(uuid()) @db.Uuid
  influencerId          String        @map("influencer_id") @db.Uuid
  campaignId            String        @map("campaign_id") @db.Uuid
  communityId           String        @map("community_id") @db.Uuid
  trackingEventId       String?       @unique @map("tracking_event_id") @db.Uuid  // link tracking or manual
  manualConversionId    String?       @unique @map("manual_conversion_id") @db.Uuid
  grossAmount           Float         @map("gross_amount")           // payoutPerConversion raw value
  platformFeeAmount     Float         @map("platform_fee_amount")    // absolute deducted
  netAmount             Float         @map("net_amount")             // after platform fee
  leaderCommission      Float         @map("leader_commission")      // leader share
  memberCommission      Float         @map("member_commission")      // member share (this influencer)
  influencerAmount      Float         @map("influencer_amount")      // actual credited to this influencer
  status                EarningStatus @default(PENDING)
  settledAt             DateTime?     @map("settled_at")
  platformFeeRate       Float         @map("platform_fee_rate")      // snapshot at time of calculation
  leaderPercentageRate  Float         @map("leader_percentage_rate") // snapshot
  memberPercentageRate  Float         @map("member_percentage_rate") // snapshot
  isLeaderCommission    Boolean       @default(false) @map("is_leader_commission") // true if this is the leader's override commission
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  // Relations
  influencer            User          @relation(fields: [influencerId], references: [id])
  campaign              Campaign      @relation(fields: [campaignId], references: [id])
  community             Community     @relation(fields: [communityId], references: [id])
  trackingEvent         TrackingEvent? @relation(fields: [trackingEventId], references: [id])
  commissionCalc        CommissionCalculation?

  @@index([influencerId])
  @@index([campaignId])
  @@index([communityId])
  @@index([status])
  @@index([createdAt])
  @@map("earnings")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMISSION CALCULATION — FR27 Immutable audit record of each calculation.
// Never updated after creation — historical integrity guarantee.
// ─────────────────────────────────────────────────────────────────────────────

model CommissionCalculation {
  id                  String    @id @default(uuid()) @db.Uuid
  earningId           String    @unique @map("earning_id") @db.Uuid
  campaignId          String    @map("campaign_id") @db.Uuid
  communityId         String    @map("community_id") @db.Uuid
  influencerId        String    @map("influencer_id") @db.Uuid
  grossAmount         Float     @map("gross_amount")
  platformFeeRate     Float     @map("platform_fee_rate")
  platformFeeAmount   Float     @map("platform_fee_amount")
  netAmount           Float     @map("net_amount")
  leaderRate          Float     @map("leader_rate")
  leaderAmount        Float     @map("leader_amount")
  memberRate          Float     @map("member_rate")
  memberAmount        Float     @map("member_amount")
  influencerAmount    Float     @map("influencer_amount")
  calculatedAt        DateTime  @default(now()) @map("calculated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // Relations
  earning             Earning   @relation(fields: [earningId], references: [id])
  campaign            Campaign  @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([communityId])
  @@index([influencerId])
  @@index([calculatedAt])
  @@map("commission_calculations")
}

// ─────────────────────────────────────────────────────────────────────────────
// INFLUENCER BALANCE — FR26 Running balance per influencer (single row, upserted)
// ─────────────────────────────────────────────────────────────────────────────

model InfluencerBalance {
  id                String    @id @default(uuid()) @db.Uuid
  influencerId      String    @unique @map("influencer_id") @db.Uuid
  totalEarnings     Float     @default(0) @map("total_earnings")     // cumulative gross credited
  pendingBalance    Float     @default(0) @map("pending_balance")    // awaiting settlement
  availableBalance  Float     @default(0) @map("available_balance")  // ready to withdraw
  withdrawnAmount   Float     @default(0) @map("withdrawn_amount")   // total paid out
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  influencer        User      @relation(fields: [influencerId], references: [id])

  @@index([influencerId])
  @@map("influencer_balances")
}

// ─────────────────────────────────────────────────────────────────────────────
// WITHDRAWAL REQUEST — FR30 Influencer withdrawal request
// Bank details stored as encrypted JSON (AES-256 in application layer).
// ─────────────────────────────────────────────────────────────────────────────

model WithdrawalRequest {
  id                String           @id @default(uuid()) @db.Uuid
  influencerId      String           @map("influencer_id") @db.Uuid
  amount            Float                                              // requested amount
  status            WithdrawalStatus @default(PENDING)
  bankDetailsEnc    String           @map("bank_details_enc") @db.Text // AES-256 encrypted JSON
  transactionRef    String?          @map("transaction_ref") @db.VarChar(100)
  reviewedBy        String?          @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at")
  reviewNote        String?          @map("review_note") @db.VarChar(500)
  requestedAt       DateTime         @default(now()) @map("requested_at")
  processedAt       DateTime?        @map("processed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  // Relations
  influencer        User             @relation(fields: [influencerId], references: [id])

  @@index([influencerId])
  @@index([status])
  @@index([requestedAt])
  @@map("withdrawal_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODULE 6: COMMUNICATION & COLLABORATION (FR32–FR37)
// ─────────────────────────────────────────────────────────────────────────────

enum ConversationType {
  COMMUNITY
  DIRECT
}

enum MessageType {
  TEXT
  VOICE
  VIDEO
  FILE
  SYSTEM
}

enum MeetingPlatform {
  GOOGLE_MEET
  ZOOM
  TEAMS
  OTHER
}

enum MeetingStatus {
  ACTIVE
  INACTIVE
}

enum ContentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Conversation {
  id           String                  @id @default(uuid()) @db.Uuid
  type         ConversationType        @default(DIRECT)
  communityId  String?                 @map("community_id") @db.Uuid
  title        String?                 @db.VarChar(255)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")

  // Relations
  community    Community?              @relation(fields: [communityId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
  @@index([communityId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at")
  leftAt         DateTime?    @map("left_at")
  lastReadAt     DateTime?    @map("last_read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  // Relations
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  senderId       String         @map("sender_id") @db.Uuid
  content        String?        @db.Text
  messageType    MessageType    @default(TEXT) @map("message_type")
  isDeleted      Boolean        @default(false) @map("is_deleted")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  // Relations
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User           @relation(fields: [senderId], references: [id])
  readReceipts   MessageRead[]
  voiceMessage   VoiceMessage?

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model MessageRead {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @map("message_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  readAt    DateTime  @default(now()) @map("read_at")

  // Relations
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reads")
}

model VoiceMessage {
  id        String    @id @default(uuid()) @db.Uuid
  messageId String    @unique @map("message_id") @db.Uuid
  fileUrl   String    @map("file_url") @db.VarChar(500)
  fileSize  Int       @map("file_size")                     // bytes
  duration  Int                                             // seconds
  mimeType  String    @map("mime_type") @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("voice_messages")
}

model CommunityVideo {
  id           String    @id @default(uuid()) @db.Uuid
  communityId  String    @map("community_id") @db.Uuid
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  videoUrl     String    @map("video_url") @db.VarChar(500)
  duration     Int                                           // seconds
  fileSize     Int       @map("file_size")                   // bytes
  mimeType     String    @map("mime_type") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  community    Community @relation(fields: [communityId], references: [id])
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([communityId])
  @@index([uploadedById])
  @@map("community_videos")
}

model MeetingLink {
  id          String          @id @default(uuid()) @db.Uuid
  communityId String          @map("community_id") @db.Uuid
  createdById String          @map("created_by_id") @db.Uuid
  title       String          @db.VarChar(255)
  description String?         @db.Text
  meetingUrl  String          @map("meeting_url") @db.VarChar(500)
  platform    MeetingPlatform @default(OTHER)
  status      MeetingStatus   @default(ACTIVE)
  scheduledAt DateTime?       @map("scheduled_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  // Relations
  community   Community       @relation(fields: [communityId], references: [id])
  createdBy   User            @relation(fields: [createdById], references: [id])

  @@index([communityId])
  @@index([status])
  @@map("meeting_links")
}

model CampaignContent {
  id           String                  @id @default(uuid()) @db.Uuid
  campaignId   String                  @map("campaign_id") @db.Uuid
  influencerId String                  @map("influencer_id") @db.Uuid
  title        String                  @db.VarChar(255)
  description  String?                 @db.Text
  videoUrl     String                  @map("video_url") @db.VarChar(500)
  duration     Int                                                  // seconds
  fileSize     Int                     @map("file_size")          // bytes
  mimeType     String                  @map("mime_type") @db.VarChar(100)
  status       ContentSubmissionStatus @default(PENDING)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  deletedAt    DateTime?               @map("deleted_at")

  // Relations
  campaign     Campaign                @relation(fields: [campaignId], references: [id])
  influencer   User                    @relation(fields: [influencerId], references: [id])
  reviews      CampaignContentReview[]

  @@index([campaignId])
  @@index([influencerId])
  @@index([status])
  @@map("campaign_contents")
}

model CampaignContentReview {
  id         String                  @id @default(uuid()) @db.Uuid
  contentId  String                  @map("content_id") @db.Uuid
  reviewerId String                  @map("reviewer_id") @db.Uuid
  status     ContentSubmissionStatus
  feedback   String?                 @db.Text
  reviewedAt DateTime                @default(now()) @map("reviewed_at")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  deletedAt  DateTime?               @map("deleted_at")

  // Relations
  content    CampaignContent         @relation(fields: [contentId], references: [id])
  reviewer   User                    @relation(fields: [reviewerId], references: [id])

  @@index([contentId])
  @@index([reviewerId])
  @@map("campaign_content_reviews")
}
